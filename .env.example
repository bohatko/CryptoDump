# Пример файла окружения для CryptoDump.
# Скопируйте в .env и подставьте свои значения. .env в git не коммитится.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Куда присылать алерты: id чата, группы или канала.
# У группы/канала id отрицательный (-100...), у личного чата — положительный.
# Несколько адресатов можно перечислить через запятую.
TELEGRAM_CHAT_ID=-1000000000000

# Токен веб-дашборда. Не нужен, пока дашборд слушает только 127.0.0.1 (по умолчанию);
# обязателен, если открыть его в сеть через dashboard.host.
# DASHBOARD_TOKEN=придумайте-длинную-строку
